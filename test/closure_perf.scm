(native Math)
;; sky_like.scm —— 复刻 sky3 的成本结构（研究用基准，非应用）
;;   1) 深层嵌套：render → shade → march → rsi / phase_r / phase_m / hdr_map；
;;   2) march 内约 40 个内部 define（大帧）；
;;   3) 每个采样点约 200 次 Scheme 调用，其中 phase_* 是 1 行数学小函数；
;;   4) 二阶结构：3 个视线采样 × 9 个方向 × (rsi + march)。
;; 目的：验证"闭包帧描述符 + 槽位寻址"在 sky3 类工作负载上的收益。

(define PI 3.141592653589793)
(define phase_r (lambda (mu) (* 0.5 (- 1.0 mu))))
(define phase_m (lambda (mu) (* 0.5 (+ 1.0 mu))))
(define hdr_map (lambda (x) (* x x)))

(define rsi (lambda (px py pz dx dy dz)
  (define t 0.0) (define qx 0.0) (define qy 0.0) (define qz 0.0)
  (define r2 0.0) (define w 0.0) (define k 0.0) (define s 0.0)
  (define acc 0.0) (define i 0)
  (set! i 0)
  (while (< i 8)
    {
      (set! t (* 0.125 (+ i 1.0)))
      (set! qx (+ px (* dx t)))
      (set! qy (+ py (* dy t)))
      (set! qz (+ pz (* dz t)))
      (set! r2 (+ (+ (* qx qx) (* qy qy)) (* qz qz)))
      (set! w (Math.sqrt r2))
      (set! k (- w 6360.0))
      (set! s (* (Math.exp (* -0.001 (* k k))) (Math.sqrt (+ 1.0 (* 0.01 (* k k))))))
      (set! acc (+ acc s))
      (set! i (+ i 1))
    })
  acc))

(define march (lambda (ox oy oz dx dy dz)
  (define mu 0.0) (define nu 0.0) (define g 0.0)
  (define acc 0.0) (define nacc 0.0) (define dir 0) (define step 0.0)
  (define a 0.0) (define b 0.0) (define c 0.0) (define d 0.0)
  (define e 0.0) (define f 0.0) (define h 0.0) (define j 0.0)
  (define l 0.0) (define m 0.0) (define n 0.0) (define o 0.0)
  (define p 0.0) (define q 0.0) (define r 0.0) (define s 0.0)
  (define u 0.0) (define v 0.0) (define y 0.0) (define z 0.0)
  (define aa 0.0) (define bb 0.0) (define cc 0.0) (define dd 0.0)
  (define ee 0.0) (define ff 0.0) (define gg 0.0) (define hh 0.0)
  (define ii 0.0) (define jj 0.0) (define kk 0.0) (define ll 0.0)
  (set! mu (+ (* dx 0.5) (* dy 0.25)))
  (set! nu (Math.sqrt (+ 1.0 (* mu mu))))
  (set! g (* (Math.exp (* -0.5 nu)) (phase_r mu)))
  (set! dir 0)
  (while (< dir 9)
    {
      (set! step (* 0.11 (+ dir 1)))
      (set! a (* step mu))
      (set! b (* step nu))
      (set! c (+ a 0.5))
      (set! d (+ b 0.5))
      (set! e (* c g))
      (set! f (* d g))
      (set! h (+ e f))
      (set! j (- e f))
      (set! l (* h h))
      (set! m (* j j))
      (set! n (+ l m))
      (set! o (- l m))
      (set! p (* n 0.125))
      (set! q (* o 0.125))
      (set! r (+ p q))
      (set! s (- p q))
      (set! u (* (hdr_map r) 0.5))
      (set! v (* (hdr_map s) 0.5))
      (set! y (+ u 0.1))
      (set! z (+ v 0.1))
      (set! aa (* y (phase_m mu)))
      (set! bb (* z (phase_m mu)))
      (set! cc (+ aa bb))
      (set! dd (- aa bb))
      (set! ee (* cc cc))
      (set! ff (* dd dd))
      (set! gg (+ ee ff))
      (set! hh (- ee ff))
      (set! ii (* gg 0.25))
      (set! jj (* hh 0.25))
      (set! kk (+ ii jj))
      (set! ll (- ii jj))
      (set! acc (+ acc (+ kk (rsi ox oy oz dx dy dz))))
      (set! nacc (+ nacc (* ll (phase_r mu))))
      (set! dir (+ dir 1))
    })
  (+ acc (* nacc 0.5))))

(define shade (lambda (px py pz)
  (define acc 0.0) (define k 0) (define t 0.0)
  (define sx 0.0) (define sy 0.0) (define sz 0.0)
  (define dx 0.0) (define dy 0.0) (define dz 0.0)
  (define lens 0.0) (define s 0.0) (define v 0.0)
  (set! k 0)
  (while (< k 3)
    {
      (set! t (* 0.33 (+ k 1)))
      (set! sx (* px t))
      (set! sy (* py t))
      (set! sz (* pz t))
      (set! dx (- sx 0.5))
      (set! dy (- sy 0.5))
      (set! dz (- sz 0.5))
      (set! lens (Math.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz))))
      (set! v (+ (march sx sy sz dx dy dz) (* 0.25 (march (+ sx 1.0) sy sz dx dy dz))))
      (set! s (Math.exp (* -0.1 lens)))
      (set! acc (+ acc (* v s)))
      (set! k (+ k 1))
    })
  acc))

(define render (lambda (n)
  (define i 0) (define j 0) (define acc 0.0)
  (define px 0.0) (define py 0.0) (define pz 0.0)
  (set! i 0)
  (while (< i n)
    {
      (set! j 0)
      (while (< j 4)
        {
          (set! px (+ 0.25 (* i 0.001)))
          (set! py (+ 0.5 (* j 0.01)))
          (set! pz (* PI 0.5))
          (set! acc (+ acc (shade px py pz)))
          (set! j (+ j 1))
        })
      (set! i (+ i 1))
    })
  acc))

;; 迭代次数可通过修改此处调节（默认规模：宿主约 1 s，基线实现约 8 s）
(display (render 600)) (newline)